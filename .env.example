# Fine-grained GitHub PAT scoped to THIS repo only.
# Required permissions: Issues (Read and write), Contents (Read and write).
GITHUB_TOKEN=

# The repo the queue lives in, as "owner/repo".
GITHUB_REPO=

# Anthropic API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which provider pipeline.py uses to summarize transcripts: "openai" or
# "anthropic". Defaults to openai.
SUMMARY_PROVIDER=openai

# Transcription fallback for caption-less videos: "openai" (audio API, no GPU
# needed — default) or "local" (faster-whisper on CUDA).
TRANSCRIBE_BACKEND=

# Optional override of the OpenAI transcription model (default whisper-1).
OPENAI_TRANSCRIBE_MODEL=

# Optional: set to 1 to always skip captions and use the transcription fallback.
FORCE_WHISPER=

# --- Always-on worker + dashboard (mini-PC mode; see SETUP_MINI_PC.md) ---
# Seconds between queue polls (default 120).
POLL_INTERVAL_SECONDS=
# Hours before a failed (labeled) issue is retried automatically (default 24).
RETRY_FAILED_HOURS=
# Dashboard bind address/port (defaults 0.0.0.0:8787).
DASHBOARD_HOST=
DASHBOARD_PORT=
