# Fine-grained GitHub PAT scoped to THIS repo only.
# Required permissions: Issues (Read and write), Contents (Read and write).
GITHUB_TOKEN=

# The repo the queue lives in, as "owner/repo".
GITHUB_REPO=

# Anthropic API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: set to 1 to always transcribe with Whisper and skip captions.
FORCE_WHISPER=
