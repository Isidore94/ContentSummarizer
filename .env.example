# Fine-grained GitHub PAT scoped to THIS repo only.
# Required permissions: Issues (Read and write), Contents (Read and write).
GITHUB_TOKEN=

# The repo the queue lives in, as "owner/repo".
GITHUB_REPO=

# Anthropic API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which provider pipeline.py uses to summarize transcripts: "openai" or
# "anthropic". Defaults to openai.
SUMMARY_PROVIDER=openai

# Transcription fallback for caption-less videos:
#   auto   = GPU node (below) when reachable, else the OpenAI audio API (default)
#   openai = OpenAI audio API (no GPU needed)
#   local  = faster-whisper on this machine's CUDA GPU
#   remote = the GPU node, failing when unreachable
TRANSCRIBE_BACKEND=

# Optional override of the OpenAI transcription model (default whisper-1).
OPENAI_TRANSCRIBE_MODEL=

# Optional: URL of a gpu_node.py instance (the PC with the CUDA GPU), e.g.
# http://MAINPC:8788. Enables "auto"/"remote" transcription.
GPU_NODE_URL=
# Optional shared secret; set the same value on both machines to require it.
GPU_NODE_TOKEN=
# Bind host/port for gpu_node.py itself (defaults 0.0.0.0:8788).
GPU_NODE_HOST=
GPU_NODE_PORT=

# Optional: set to 1 to always skip captions and use the transcription fallback.
FORCE_WHISPER=

# --- Local server / worker + dashboard (serve.py; also mini-PC mode) ---
# Seconds between queue polls (default 120; serve.py setups often use 30).
POLL_INTERVAL_SECONDS=
# Seconds between summary auto-syncs from the repo (dashboard reader; default 60).
SUMMARY_PULL_SECONDS=
# Hours before a failed (labeled) issue is retried automatically (default 24).
RETRY_FAILED_HOURS=
# Dashboard bind address/port (defaults 0.0.0.0:8787).
DASHBOARD_HOST=
DASHBOARD_PORT=
